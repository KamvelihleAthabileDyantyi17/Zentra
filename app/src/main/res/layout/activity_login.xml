<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Shanon's Food Truck" android:textSize="26sp" android:textStyle="bold"/>
    <EditText android:id="@+id/inputEmail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:hint="Email" android:inputType="textEmailAddress"/>
    <EditText android:id="@+id/inputPassword" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Password"
        android:inputType="textPassword"/>
    <Button android:id="@+id/buttonLogin" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Log in"/>
    <Button android:id="@+id/buttonRegister" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Register"/>
    <Button android:id="@+id/buttonGoogle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Sign in with Google"/>
</LinearLayout>
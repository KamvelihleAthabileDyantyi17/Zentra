<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The real theme lives in Compose (ui/theme). This only paints the window before Compose draws. -->
    <style name="Theme.ShannosFoodTruck" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
